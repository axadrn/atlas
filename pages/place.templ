package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"atlas/components/badge"
	"atlas/components/card"
	"atlas/components/icon"
	"atlas/internal/catalog"
	"atlas/layouts"
)

func placePopulation(population *int64) string {
	if population == nil {
		return "Not available yet"
	}
	return fmt.Sprintf("%s people", formatNumber(*population))
}

func formatNumber(value int64) string {
	digits := strconv.FormatInt(value, 10)
	for index := len(digits) - 3; index > 0; index -= 3 {
		digits = digits[:index] + "," + digits[index:]
	}
	return digits
}

func osmEmbedURL(coordinates *catalog.Coordinates) string {
	if coordinates == nil {
		return ""
	}
	latitude := coordinates.Latitude
	longitude := coordinates.Longitude
	query := url.Values{}
	query.Set("bbox", fmt.Sprintf("%.6f,%.6f,%.6f,%.6f", longitude-0.12, latitude-0.08, longitude+0.12, latitude+0.08))
	query.Set("layer", "mapnik")
	query.Set("marker", fmt.Sprintf("%.6f,%.6f", latitude, longitude))
	return "https://www.openstreetmap.org/export/embed.html?" + query.Encode()
}

func sourceDate(value string) string {
	retrievedAt, err := time.Parse(time.RFC3339Nano, value)
	if err != nil {
		return value
	}
	return retrievedAt.Format("2 Jan 2006")
}

templ Place(place catalog.PlaceSummary, sources []catalog.SourceAttribution) {
	@layouts.Base(place.Name + " | Atlas") {
		<main class="mx-auto min-h-dvh w-full max-w-6xl px-5 py-6 sm:px-8 sm:py-10">
			<header class="mb-10 flex items-center justify-between">
				<a href="/" class="font-heading text-xl font-bold tracking-tight">atlas</a>
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ string(place.Kind) }
				}
			</header>
			<div class="grid gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.35fr)] lg:items-start">
				<section>
					<p class="mb-2 text-sm font-medium uppercase tracking-[0.18em] text-primary">{ place.CountryCode }</p>
					<h1 class="font-heading text-4xl font-bold tracking-tight sm:text-6xl">{ place.Name }</h1>
					<p class="mt-4 max-w-xl text-lg text-muted-foreground">
						A live place page built from sourced public data. Community signals, costs and practical nomad knowledge come next.
					</p>
					@card.Card(card.Props{Size: card.SizeSm, Class: "mt-10 gap-0 py-0"}) {
						@card.Content(card.ContentProps{Class: "grid grid-cols-2 divide-x p-0"}) {
							<div class="p-5">
								<div class="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
									@icon.Users(icon.Props{Class: "size-4"})
									Population
								</div>
								<p class="font-heading text-lg font-semibold">{ placePopulation(place.Population) }</p>
							</div>
							<div class="p-5">
								<div class="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
									@icon.Clock(icon.Props{Class: "size-4"})
									Timezone
								</div>
								<p class="font-heading text-lg font-semibold">{ place.Timezone }</p>
							</div>
						}
					}
				</section>
				if place.Coordinates != nil {
					@card.Card(card.Props{Class: "gap-0 py-0"}) {
						<iframe
							class="h-[52vh] min-h-96 w-full"
							src={ osmEmbedURL(place.Coordinates) }
							title={ "Map of " + place.Name }
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
						@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
							Map data © <a class="ml-1 underline underline-offset-2" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>
						}
					}
				}
			</div>
			if len(sources) > 0 {
				<section class="mt-12 border-t pt-8">
					<div class="mb-5">
						<h2 class="font-heading text-2xl font-semibold">Sources</h2>
						<p class="mt-1 text-sm text-muted-foreground">Where this place record came from and when Atlas retrieved it.</p>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						for _, source := range sources {
							@card.Card(card.Props{Size: card.SizeSm}) {
								@card.Header() {
									@card.Title() {
										<a class="underline-offset-4 hover:underline" href={ templ.SafeURL(source.HomepageURL) } target="_blank" rel="noreferrer">{ source.Name }</a>
									}
									@card.Description() {
										Published by { source.Publisher }
									}
									@card.Action() {
										@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
											{ source.LicenseName }
										}
									}
								}
								@card.Content(card.ContentProps{Class: "space-y-2 text-xs text-muted-foreground"}) {
									<p>Imported { sourceDate(source.RetrievedAt) }</p>
									<p class="flex flex-wrap gap-x-3 gap-y-1">
										<a class="underline underline-offset-2" href={ templ.SafeURL(source.OriginURL) } target="_blank" rel="noreferrer">Exact dataset</a>
										if source.LicenseURL != "" {
											<a class="underline underline-offset-2" href={ templ.SafeURL(source.LicenseURL) } target="_blank" rel="noreferrer">License</a>
										}
									</p>
								}
							}
						}
					</div>
				</section>
			}
		</main>
	}
}
