package pages

import (
	"fmt"
	"strconv"
	"time"

	"atlas/components/badge"
	"atlas/components/breadcrumb"
	"atlas/components/card"
	"atlas/components/icon"
	"atlas/internal/catalog"
	"atlas/layouts"
)

func placePopulation(population *int64) string {
	if population == nil {
		return "Not available yet"
	}
	return fmt.Sprintf("%s people", formatNumber(*population))
}

func formatNumber(value int64) string {
	digits := strconv.FormatInt(value, 10)
	for index := len(digits) - 3; index > 0; index -= 3 {
		digits = digits[:index] + "," + digits[index:]
	}
	return digits
}

func placeMapAttributes(place catalog.PlaceSummary) templ.Attributes {
	attributes := templ.Attributes{
		"data-place-map": true,
	}
	if place.Bounds != nil {
		attributes["data-west"] = strconv.FormatFloat(place.Bounds.West, 'f', 6, 64)
		attributes["data-south"] = strconv.FormatFloat(place.Bounds.South, 'f', 6, 64)
		attributes["data-east"] = strconv.FormatFloat(place.Bounds.East, 'f', 6, 64)
		attributes["data-north"] = strconv.FormatFloat(place.Bounds.North, 'f', 6, 64)
	}
	if place.Coordinates != nil {
		attributes["data-longitude"] = strconv.FormatFloat(place.Coordinates.Longitude, 'f', 6, 64)
		attributes["data-latitude"] = strconv.FormatFloat(place.Coordinates.Latitude, 'f', 6, 64)
	}
	return attributes
}

func placeTimezoneLabel(place catalog.PlaceSummary) string {
	if len(place.Timezones) > 1 {
		return "Time zones"
	}
	return "Timezone"
}

func placeTimezone(place catalog.PlaceSummary) string {
	if len(place.Timezones) == 0 {
		return "Not available yet"
	}
	if len(place.Timezones) == 1 {
		return place.Timezones[0]
	}
	return fmt.Sprintf("%d time zones", len(place.Timezones))
}

func placeTypeLabel(placeType catalog.PlaceType) string {
	switch placeType {
	case catalog.PlaceTypeCountry:
		return "Country"
	case catalog.PlaceTypeRegion:
		return "Region"
	case catalog.PlaceTypeNeighborhood:
		return "Neighborhood"
	default:
		return "Locality"
	}
}

func showPlaceTypeBadge(placeType catalog.PlaceType) bool {
	return placeType == catalog.PlaceTypeRegion || placeType == catalog.PlaceTypeNeighborhood
}

func childSectionTitle(place catalog.PlaceSummary) string {
	if place.Type == catalog.PlaceTypeLocality {
		return "Neighborhoods"
	}
	return "Places to explore"
}

func childSectionDescription(place catalog.PlaceSummary) string {
	if place.Type == catalog.PlaceTypeLocality {
		return "Neighborhoods to explore in " + place.Name + "."
	}
	return "Curated destinations in " + place.Name + "."
}

// missingFacts lists what Atlas does not know about this place yet: sourced
// fields without data plus the community categories that open with accounts.
func missingFacts(place catalog.PlaceSummary) []string {
	var missing []string
	if place.Population == nil {
		missing = append(missing, "Population")
	}
	if len(place.Timezones) == 0 {
		missing = append(missing, "Timezone")
	}
	return append(missing, "Cost of living", "Internet", "Safety", "Best months")
}

func curatedRankLabel(rank *int64) string {
	return fmt.Sprintf("Top destination #%d", *rank)
}

// dataFreshness names the newest retrieval date across the place's sources,
// so visitors see how old the sourced facts are. RFC 3339 strings compare
// lexically, no parsing needed to find the newest.
func dataFreshness(sources []catalog.SourceAttribution) string {
	newest := ""
	for _, source := range sources {
		if source.RetrievedAt > newest {
			newest = source.RetrievedAt
		}
	}
	if newest == "" {
		return ""
	}
	return "Sourced public data, updated " + sourceDate(newest)
}

func sourceDate(value string) string {
	retrievedAt, err := time.Parse(time.RFC3339Nano, value)
	if err != nil {
		return value
	}
	return retrievedAt.Format("2 Jan 2006")
}

templ Place(place catalog.PlaceSummary, ancestors []catalog.PlaceSummary, sources []catalog.SourceAttribution, children []catalog.PlaceSummary) {
	@layouts.Base(place.Name + " | Atlas", true) {
		@navigation(true)
		<main class="mx-auto w-full max-w-6xl flex-1 px-5 py-8 sm:px-8 sm:py-10">
			<div class="grid gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.35fr)] lg:items-start">
				<section class="min-w-0">
					if len(ancestors) > 0 {
						@breadcrumb.Breadcrumb(breadcrumb.Props{Class: "mb-4"}) {
							@breadcrumb.List() {
								@breadcrumb.Item() {
									@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
										Atlas
									}
								}
								for _, ancestor := range ancestors {
									@breadcrumb.Separator()
									@breadcrumb.Item() {
										@breadcrumb.Link(breadcrumb.LinkProps{Href: "/places/" + ancestor.Slug}) {
											{ ancestor.Name }
										}
									}
								}
								@breadcrumb.Separator()
								@breadcrumb.Item() {
									@breadcrumb.Page() {
										{ place.Name }
									}
								}
							}
						}
					}
					if showPlaceTypeBadge(place.Type) || place.CuratedRank != nil {
						<div class="mb-2 flex items-center gap-2">
							if place.CuratedRank != nil {
								@badge.Badge() {
									{ curatedRankLabel(place.CuratedRank) }
								}
							}
							if showPlaceTypeBadge(place.Type) {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									{ placeTypeLabel(place.Type) }
								}
							}
						</div>
					}
					<h1 class="min-w-0 break-words font-heading text-4xl font-bold tracking-tight sm:text-5xl xl:text-6xl">{ place.Name }</h1>
					<p class="mt-4 max-w-xl text-lg text-muted-foreground">
						A live place page built from sourced public data. Community signals, costs and practical nomad knowledge come next.
					</p>
					@card.Card(card.Props{Size: card.SizeSm, Class: "mt-10 gap-0 overflow-hidden rounded-2xl py-0 shadow-sm"}) {
						@card.Content(card.ContentProps{Class: "grid grid-cols-2 divide-x p-0"}) {
							<div class="p-5">
								<div class="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
									@icon.Users(icon.Props{Class: "size-4"})
									Population
								</div>
								<p class="font-heading text-lg font-semibold">{ placePopulation(place.Population) }</p>
							</div>
							<div class="p-5">
								<div class="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
									@icon.Clock(icon.Props{Class: "size-4"})
									{ placeTimezoneLabel(place) }
								</div>
								<p class="font-heading text-lg font-semibold">{ placeTimezone(place) }</p>
							</div>
						}
						if freshness := dataFreshness(sources); freshness != "" {
							@card.Footer(card.FooterProps{Class: "border-t py-3 text-xs text-muted-foreground"}) {
								<a href="/credits" class="underline-offset-2 hover:underline">{ freshness }</a>
							}
						}
					}
					<div class="mt-4 rounded-2xl border border-dashed p-5">
						<p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Not in Atlas yet</p>
						<div class="mt-3 flex flex-wrap gap-2">
							for _, fact := range missingFacts(place) {
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
									{ fact }
								}
							}
						</div>
						<p class="mt-3 text-sm text-muted-foreground">
							Atlas only shows what it can source. Community contributions open these up once accounts land.
						</p>
					</div>
				</section>
				if place.Bounds != nil || place.Coordinates != nil {
					@card.Card(card.Props{Class: "gap-0 overflow-hidden rounded-2xl py-0 shadow-sm"}) {
						<div class="relative h-[52vh] min-h-96 w-full overflow-hidden rounded-t-2xl bg-muted" { placeMapAttributes(place)... }>
							<div class="h-full w-full overflow-hidden rounded-t-2xl" data-map-canvas></div>
							<label class="absolute right-3 top-3 z-10">
								<span class="sr-only">Map style</span>
								<select class="h-8 rounded-lg border border-border bg-background/95 px-2 text-xs font-medium text-foreground shadow-sm backdrop-blur" data-map-style aria-label="Map style">
									<option value="liberty">Atlas</option>
									<option value="positron">Light</option>
									<option value="dark">Dark</option>
								</select>
							</label>
						</div>
						@card.Footer(card.FooterProps{Class: "text-xs text-muted-foreground"}) {
							Map data © <a class="ml-1 underline underline-offset-2" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>. Tiles by <a class="ml-1 underline underline-offset-2" href="https://openfreemap.org/" target="_blank" rel="noreferrer">OpenFreeMap</a>.
						}
					}
				}
			</div>
			if len(children) > 0 {
				<section class="mt-12">
					<div class="mb-5">
						<h2 class="font-heading text-2xl font-bold tracking-tight">{ childSectionTitle(place) }</h2>
						<p class="mt-1 text-sm text-muted-foreground">{ childSectionDescription(place) }</p>
					</div>
					<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
						for _, child := range children {
							<a href={ templ.SafeURL("/places/" + child.Slug) } class="rounded-xl border bg-card p-4 transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
								<div class="flex items-start justify-between gap-3">
									<h3 class="font-heading text-base font-semibold">{ child.Name }</h3>
									<span class="text-xs font-medium text-muted-foreground">{ placeTypeLabel(child.Type) }</span>
								</div>
								if child.Population != nil {
									<p class="mt-2 text-sm text-muted-foreground">{ placePopulation(child.Population) }</p>
								}
							</a>
						}
					</div>
				</section>
			}
		</main>
	}
}
