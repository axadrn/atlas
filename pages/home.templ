package pages

import (
	"fmt"

	"atlas/components/badge"
	"atlas/components/button"
	"atlas/components/combobox"
	"atlas/internal/catalog"
	"atlas/layouts"
	"atlas/utils"
)

func formatStars(n int) string {
	if n >= 1000 {
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

func searchPopulation(population *int64) string {
	if population == nil {
		return ""
	}
	if *population >= 1_000_000 {
		return fmt.Sprintf("%.1fM", float64(*population)/1_000_000)
	}
	if *population >= 1_000 {
		return fmt.Sprintf("%.0fk", float64(*population)/1_000)
	}
	return fmt.Sprintf("%d", *population)
}

type globePlace struct {
	Name        string  `json:"name"`
	CountryCode string  `json:"country_code"`
	Slug        string  `json:"slug"`
	Latitude    float64 `json:"latitude"`
	Longitude   float64 `json:"longitude"`
	Population  *int64  `json:"population,omitempty"`
}

func globePlaceData(places []catalog.PlaceSummary) []globePlace {
	result := make([]globePlace, 0, len(places))
	for _, place := range places {
		if place.Coordinates == nil {
			continue
		}
		result = append(result, globePlace{
			Name:        place.Name,
			CountryCode: place.CountryCode,
			Slug:        place.Slug,
			Latitude:    place.Coordinates.Latitude,
			Longitude:   place.Coordinates.Longitude,
			Population:  place.Population,
		})
	}
	return result
}

templ placeSearch(id string, class string) {
	{{ comboboxID := "place-search-" + id }}
	{{ inputID := comboboxID + "-input" }}
	<div data-place-search class="relative z-20 w-full max-w-xl">
		<label for={ inputID } class="sr-only">Search countries and cities</label>
		@combobox.Combobox(combobox.Props{ID: comboboxID, AutoHighlight: true}) {
			@combobox.Input(combobox.InputProps{
				ID:          inputID,
				Class:       utils.CN("w-full", class),
				Placeholder: "Search places...",
				HideTrigger: true,
				Attributes: templ.Attributes{
					"data-place-search-input": "",
				},
			})
			@combobox.Content(combobox.ContentProps{
				Attributes: templ.Attributes{
					"data-place-search-content": "",
				},
			}) {
				@combobox.Empty(combobox.EmptyProps{
					Class: "py-4",
					Attributes: templ.Attributes{
						"data-place-search-empty": "",
					},
				}) {
					Type at least two characters.
				}
				@combobox.List(combobox.ListProps{
					Attributes: templ.Attributes{
						"data-place-search-results": "",
					},
				})
			}
		}
	</div>
}

templ PlaceSearchResults(places []catalog.PlaceSummary) {
	for _, place := range places {
		@combobox.Item(combobox.ItemProps{
			Value: place.Slug,
			Label: place.Name,
		}) {
			<span class="min-w-0 flex-1">
				<span class="block truncate font-medium">{ place.Name }</span>
				<span class="block text-xs text-muted-foreground">{ place.CountryCode } · { placeTypeLabel(place.Type) }</span>
			</span>
			if place.Population != nil {
				<span class="shrink-0 pr-1 text-xs tabular-nums text-muted-foreground">{ searchPopulation(place.Population) }</span>
			}
		}
	}
}

templ Home(stars int, places []catalog.PlaceSummary) {
	@layouts.Base("atlas", false) {
		@navigation()
		<main class="mx-auto flex min-h-[calc(100dvh-5rem)] max-w-4xl flex-col items-center justify-center gap-4 overflow-hidden px-6 py-8">
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				coming soon
			}
			<h1 class="max-w-2xl text-balance text-center font-heading text-3xl font-bold tracking-tight sm:text-5xl">
				The open source home for digital nomads.
			</h1>
			<p class="max-w-xl text-pretty text-center text-base text-muted-foreground sm:text-lg">
				Explore destinations with sourced public data and community-verified nomad
				knowledge. Open source, international from day one and built to improve
				with every useful contribution.
			</p>
			<div class="flex min-h-0 w-full flex-1 items-center justify-center">
				<canvas id="globe" class="block touch-none"></canvas>
			</div>
			<p id="globe-caption" class="min-h-5 text-center text-sm text-muted-foreground">
				Drag the globe. Select a destination.
			</p>
			@button.Button(button.Props{Variant: button.VariantOutline, Href: "https://github.com/axadrn/atlas", Target: "_blank"}) {
				<svg viewBox="0 0 16 16" class="size-4 fill-current" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
				</svg>
				Star on GitHub
				if stars > 0 {
					<span class="tabular-nums text-muted-foreground">{ formatStars(stars) }</span>
				}
			}
		</main>
		@templ.JSONScript("atlas-globe-places", globePlaceData(places))
		<script nonce={ templ.GetNonce(ctx) } src="/assets/js/landmask.js"></script>
		<script nonce={ templ.GetNonce(ctx) } src="/assets/js/globe.js" defer></script>
	}
}
