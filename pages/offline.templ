package pages

import (
	"atlas/components/button"
	"atlas/components/card"
	"atlas/components/icon"
	"atlas/layouts"
)

templ Offline() {
	@layouts.Base("Offline | Atlas", false) {
		@navigation(false)
		<main class="mx-auto flex min-h-[calc(100dvh-4.5rem)] max-w-lg items-center px-6 py-12">
			@card.Card(card.Props{Class: "w-full rounded-2xl text-center"}) {
				@card.Header() {
					<div class="mx-auto mb-2 flex size-12 items-center justify-center rounded-xl bg-muted">
						@icon.WifiOff(icon.Props{Class: "size-6 text-muted-foreground"})
					</div>
					@card.Title(card.TitleProps{Class: "font-heading text-2xl"}) {
						Atlas is offline
					}
					@card.Description() {
						Reconnect to load live place data. Private pages and data responses are never stored for offline use.
					}
				}
				@card.Footer(card.FooterProps{Class: "justify-center"}) {
					@button.Button(button.Props{Href: "/"}) {
						Try again
					}
				}
			}
		</main>
	}
}
