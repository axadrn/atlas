package layouts

import "atlas/components"

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			// Set the dark class before first paint so there is no theme flash.
			<script nonce={ templ.GetNonce(ctx) }>
				(function () {
					const pref = localStorage.getItem("theme") || "system";
					const dark = pref === "system"
						? window.matchMedia("(prefers-color-scheme: dark)").matches
						: pref === "dark";
					document.documentElement.classList.toggle("dark", dark);
				})();
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			// htmx is the stack's swap layer: blocks like dashboard-01 drive
			// their partial updates (pagination, lazy drawers) through hx-*
			// attributes against templ fragments. Swap in your own layer
			// (Datastar etc.) by translating those attributes.
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6/dist/htmx.min.js"></script>
			@components.Scripts()
		</head>
		<body>
			{ children... }
			<div class="fixed bottom-4 right-4 z-50 opacity-40 transition-opacity duration-200 hover:opacity-100">
				@ThemeSwitcher("")
			</div>
		</body>
	</html>
}
