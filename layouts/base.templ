package layouts

import "atlas/components"

templ Base(title string, mapEnabled bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#101415" media="(prefers-color-scheme: dark)"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<meta name="apple-mobile-web-app-title" content="Atlas"/>
			<title>{ title }</title>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon-180.png"/>
			// Set the dark class before first paint so there is no theme flash.
			<script nonce={ templ.GetNonce(ctx) }>
				(function () {
					const pref = localStorage.getItem("theme") || "system";
					const dark = pref === "system"
						? window.matchMedia("(prefers-color-scheme: dark)").matches
						: pref === "dark";
					document.documentElement.classList.toggle("dark", dark);
				})();
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			if mapEnabled {
				<link rel="stylesheet" href="/assets/vendor/maplibre-gl-5.24.0.css"/>
				<script nonce={ templ.GetNonce(ctx) } src="/assets/vendor/maplibre-gl-csp-5.24.0.js" defer></script>
				<script nonce={ templ.GetNonce(ctx) } src="/assets/js/place-map.js" defer></script>
			}
			@components.Scripts()
			<script nonce={ templ.GetNonce(ctx) } src="/assets/js/place-search.js" defer></script>
			<script nonce={ templ.GetNonce(ctx) } src="/assets/js/pwa.js" defer></script>
		</head>
		<body class="flex min-h-dvh flex-col">
			{ children... }
			<footer class="mt-auto shrink-0">
				<div class="mx-auto w-full max-w-6xl px-4 xl:px-6">
					<div class="flex items-center justify-between py-2">
						<div class="w-full px-1 text-center text-xs leading-loose text-muted-foreground sm:text-sm">
							Built by{ " " }<a href="https://x.com/axadrn" target="_blank" rel="noreferrer" class="font-medium underline underline-offset-4">Axel Adrian</a>.
							The source code is available on{ " " }<a href="https://github.com/axadrn/atlas" target="_blank" rel="noreferrer" class="font-medium underline underline-offset-4">GitHub</a>.
						</div>
					</div>
				</div>
			</footer>
		</body>
	</html>
}
